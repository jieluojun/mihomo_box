#!/bin/sh /etc/rc.common
# ============================================================
# Mihomo Box · OpenWrt 服务脚本（procd）
#
#   /etc/init.d/mihomo_box start | stop | restart | enable | disable
#
# 由 procd 监督 scripts/box.sh supervise —— 那个守护负责：
#   · 开机时按 autostart 拉起内核
#   · 面板 httpd 掉线自动拉起（每 20s 检查）
#   · 收到 stop 时把面板与内核一起停掉
# 内核本身不设自动重启：面板上的「停止」是用户意图，不该被守护立刻拉回来。
# ============================================================
USE_PROCD=1
START=96
STOP=11

BOX=/etc/mihomo_box/scripts/box.sh

start_service() {
  config_load mihomo_box
  local enabled
  config_get_bool enabled main enabled 1
  if [ "$enabled" != "1" ]; then
    logger -t mihomo_box "服务在 /etc/config/mihomo_box 里被停用（enabled=0），跳过启动"
    return 0
  fi
  [ -x "$BOX" ] || { logger -t mihomo_box "缺少 $BOX，无法启动"; return 1; }
  procd_open_instance
  procd_set_param command "$BOX" supervise
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file /etc/config/mihomo_box
  procd_close_instance
}

stop_service() {
  [ -x "$BOX" ] && "$BOX" stop >/dev/null 2>&1
}

reload_service() {
  [ -x "$BOX" ] && "$BOX" restart >/dev/null 2>&1
}

service_triggers() {
  procd_add_reload_trigger mihomo_box
}
