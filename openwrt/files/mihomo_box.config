# Mihomo Box · OpenWrt 服务配置（UCI）
#
# 语法：uci set mihomo_box.main.enabled=0 && uci commit && /etc/init.d/mihomo_box restart
#
# 说明：这里只管「服务本身的开关」。面板端口、访问令牌、开机自启内核、下载镜像、
# 配置内容等都在安装目录 /etc/mihomo_box 下（module-settings.conf / config.yaml），
# 面板界面上就能改 —— 两处不重复，避免出现「两个地方各说一套」。
config main 'main'
	option enabled '1'
